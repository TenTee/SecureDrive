
# --- ONLYOFFICE Document Server (online editing / co-editing) ---
# Same value as JWT_SECRET in docker-compose.yml (ONLYOFFICE_JWT_SECRET).
ONLYOFFICE_JWT_SECRET=
# URL the Document Server uses to reach THIS backend (callback on save).
# Local Docker: http://host.docker.internal:4000 — production: your public HTTPS API URL.
ONLYOFFICE_BACKEND_URL=http://host.docker.internal:4000
# URL the BACKEND uses to call the Document Server (thumbnails / conversion).
ONLYOFFICE_INTERNAL_URL=http://localhost:8080
